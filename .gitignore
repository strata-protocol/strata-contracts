/target
**/*.rs.bk
*.pdb

# Generated by the Soroban test framework on every run. Nothing asserts
# against these, so they are output rather than fixtures. Committing them
# would leave stale snapshots behind whenever a test is renamed.
test_snapshots/

# stellar-cli
.stellar/
*.json.tmp

# local env / secrets
.env
.env.*
!.env.example

# editors
.idea/
.vscode/
*.swp
.DS_Store
